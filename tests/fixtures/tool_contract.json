            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Two-letter source country code, e.g. AT"
        },
        "source_fqdn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact source FQDN, e.g. www.example.com"
        },
        "source_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source IP or CIDR, e.g. 192.0.2.1 or 192.0.2.0/24"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO timestamp, exclusive upper bound on time.source"
        }
      },
      "required": [
        "group_by"
      ],
      "type": "object"
    }
  },
  "list_tables": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "List tables and views in the eventdb with their estimated number of rows.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    }
  },
  "run_sql": {
    "annotations": {
      "readOnlyHint": true
    },
    "description": "Run a read-only SELECT. Double-quote dotted column names; always use LIMIT.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "description": "One read-only SELECT statement",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    }
  },
